# Optional: enables conversational responses through OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Consolidated company information and FAQ knowledge base
NIVORA_KNOWLEDGE_FILE=data/nivora_knowledge_base.txt

# Optional external product catalogue workbook path.
# The workbook is not included in this repository.
# NIVORA_PRODUCT_FILE=C:/path/to/your/approved_catalogue.xlsx

# Comma-separated browser origins are only needed if a separate browser frontend is added.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_MIN_RELEVANCE=0.22
